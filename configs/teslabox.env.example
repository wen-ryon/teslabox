TESLABOX_HTTP_ADDR=:80
# 正式产品构建内置统一证书服务地址、公钥和本地路由别名，用户无需配置 DNS 或证书。
# 以下仅供维护者覆盖构建配置；不在这里填写 DNS API 密钥或证书私钥。
# TESLABOX_HTTPS_CERTIFICATE_ENDPOINT=https://certs.teslabox.online:46654
# TESLABOX_HTTPS_CERTIFICATE_PUBLIC_KEY=Base64编码的证书发布公钥
# TESLABOX_HTTPS_CERTIFICATE_IDENTITY=/var/lib/teslabox-system/cert-delivery/identity.json
# 产品版本默认读取独立持久配置；此覆盖项只供旧实验部署迁移使用。
# TESLABOX_CARPLAY_SERVICE_SETTINGS=/var/lib/teslabox-system/carplay/service.json
# 软件 MFi 身份由登记服务私下下载，不包含在公开升级包中。
# TESLABOX_CARPLAY_MFI_DIRECTORY=/var/lib/teslabox-system/carplay/mfi
# 以下两项只用于兼容旧部署；新部署会在认证状态文件中保存带随机盐的慢哈希和会话密钥。
# printf '%s' '你的管理密码' | sha256sum
# openssl rand -hex 32
# TESLABOX_WEB_PASSWORD_SHA256=
# TESLABOX_WEB_SESSION_SECRET=
TESLABOX_WEB_SESSION_TTL=168h
TESLABOX_DATA_LABEL=TESLABOX
# 初始化后优先配置文件系统 UUID，避免依赖可能变化的 /dev/sdX 名称。
# TESLABOX_DATA_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TESLABOX_DATA_MOUNT_PATH=/var/lib/teslabox
TESLABOX_IMAGE_PATH=images/teslacam.img
TESLABOX_SNAPSHOT_PATH=snapshots
TESLABOX_SNAPSHOT_MOUNT_PATH=/run/teslabox/snapshots
TESLABOX_INDEX_PATH=index
TESLABOX_STATE_PATH=state
# 录像缓存和导出暂存保存在系统盘，上传引用会保护仍在使用的录像。
TESLABOX_MEDIA_WORK_PATH=/var/lib/teslabox-system/media
TESLABOX_RECORDING_CACHE_TTL=24h
# 单工作进程配合有界队列，避免同时争抢 MPP/RGA。
TESLABOX_EXPORT_PATH=exports
# 导出历史与保留策略放在系统盘，避免重启后丢失“再次下载”列表。
TESLABOX_EXPORT_STATE=/var/lib/teslabox-system/export-state.json
# 设为 0s 时仅受当前录像范围和可用空间限制。
TESLABOX_EXPORT_MAX_DURATION=0s
TESLABOX_EXPORT_QUEUE_SIZE=4
# 活动数据盘身份和初始化进度保存在系统盘，不能放到可拔数据盘内。
TESLABOX_STORAGE_REGISTRY=/var/lib/teslabox-system/storage-registry.json
# 管理密码、随机盐和会话密钥保存在 TF 系统盘；全新安装默认密码为 teslabox，并强制首次修改。
TESLABOX_WEB_AUTH_STATE=/var/lib/teslabox-system/web-auth.json
# 自动维护恢复的开关状态保存在 TF 系统盘；默认关闭，需在设置中心明确开启。
TESLABOX_MAINTENANCE_STATE=/var/lib/teslabox-system/maintenance.json
# 页面引导和按稳定设备标识记录的存储引导状态保存在 TF 系统盘，不依赖浏览器访问地址。
TESLABOX_ONBOARDING_STATE=/var/lib/teslabox-system/onboarding.json
# Tesla 文件名是车辆本地墙上时间，不应依赖板子系统时区；中国大陆车辆保持 Asia/Shanghai。
TESLABOX_TESLA_TIME_ZONE=Asia/Shanghai
# 在线更新只信任与下列 Ed25519 公钥匹配的清单；未同时配置时设置页会显示未启用。
# TESLABOX_UPDATE_MANIFEST_URL=https://gitee.com/你的账号/teslabox/releases/download/latest/latest.json
# 可选：维护者签名的历史主程序目录。未配置时会从同目录 latest.json 自动推导 history.json。
# TESLABOX_UPDATE_CATALOG_URL=https://gitee.com/你的账号/teslabox-releases/raw/main/stable/history.json
# 内测通道使用独立的签名清单和历史目录；稳定版绝不会读取这些地址。
# TESLABOX_UPDATE_BETA_MANIFEST_URL=https://gitee.com/你的账号/teslabox-releases/raw/main/beta/latest.json
# TESLABOX_UPDATE_BETA_CATALOG_URL=https://gitee.com/你的账号/teslabox-releases/raw/main/beta/history.json
# TESLABOX_UPDATE_PUBLIC_KEY=Base64编码的Ed25519公钥
TESLABOX_UPDATE_CHANNEL=stable
# 页面选择的通道会原子保存；删除该文件后下次启动回到上面的默认通道。
TESLABOX_UPDATE_CHANNEL_STATE=/var/lib/teslabox-system/update-channel.json
TESLABOX_UPDATE_BOARD=radxa-rock-3a
TESLABOX_CONFIGFS_PATH=/sys/kernel/config/usb_gadget
TESLABOX_UDC_PATH=/sys/class/udc
# 同一系统开机周期只允许一次 UDC 绑定尝试；不要改成临时文件路径。
TESLABOX_BOOT_ID_PATH=/proc/sys/kernel/random/boot_id
# 新绑定只允许发生在内核启动后的安全窗口；读取失败时禁止新绑定但不拆除既有 Gadget。
TESLABOX_BOOT_UPTIME_PATH=/proc/uptime
# 启动保护状态位于系统盘，更新或服务重启后仍保持 Gadget 解绑。
TESLABOX_GADGET_PAUSE_STATE=/var/lib/teslabox-system/gadget-paused
# TESLABOX_UDC_NAME=fcc00000.dwc3
TESLABOX_GADGET_NAME=teslabox
TESLABOX_GADGET_SERIAL=TESLABOX-071C4AAFBA8BEB80
TESLABOX_RELEASE_GADGET=radxa-otgutils
# 留空时自动识别 NetworkManager 中的物理无线接口；仅在自动识别不正确时手动填写。
# TESLABOX_WIFI_INTERFACE=wlp2s0
# 热点虚拟接口默认使用连接配置中的名称或 ap0；如名称冲突，可填写不超过 15 个字符的其他名称。
# TESLABOX_AP_INTERFACE=hotspot0
# 打开录像页后的短时高频快照间隔；无人查看时不会按该间隔反复复制和挂载镜像。
TESLABOX_SCAN_INTERVAL=1m
# 兼容旧版本保留；当前版本在媒体活跃期结束后直接释放 reflink，重新进入录像页时再即时刷新。
TESLABOX_SNAPSHOT_IDLE_INTERVAL=5m
# 进入录像浏览后保持高频快照的时长；期间可及时发现新完成的录像片段。
TESLABOX_SNAPSHOT_ACTIVE_WINDOW=2m
TESLABOX_POLL_INTERVAL=3s
TESLABOX_OPERATION_TIMEOUT=15s
TESLABOX_SNAPSHOT_TIMEOUT=2m
# 连续失败时指数退避的最大间隔，手动 POST /api/v1/scan 不受自动退避限制。
TESLABOX_SNAPSHOT_RETRY_MAX=10m
# Rockchip 媒体工具链保持独立安装，避免覆盖系统软件包提供的 FFmpeg。
TESLABOX_FFMPEG_PATH=/opt/teslabox/media/bin/ffmpeg
TESLABOX_FFPROBE_PATH=/opt/teslabox/media/bin/ffprobe
TESLABOX_MEDIA_PROBE_TIMEOUT=10s
# 低于任一门槛时停止创建新快照，但保持 Gadget 和最后一个可用媒体快照。
TESLABOX_MIN_FREE_BYTES=8589934592
TESLABOX_MIN_FREE_PERCENT=5
TESLABOX_SHUTDOWN_TIMEOUT=10s
