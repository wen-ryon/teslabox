TESLABOX_HTTP_ADDR=:8080
# Web 密码只保存 SHA-256 摘要，会话密钥至少使用 32 字节随机值；二者必须同时配置。
# 未配置时保留无认证模式，便于首次调试，但不建议在车载网络中长期使用。
# printf '%s' '你的管理密码' | sha256sum
# openssl rand -hex 32
# TESLABOX_WEB_PASSWORD_SHA256=
# TESLABOX_WEB_SESSION_SECRET=
TESLABOX_WEB_SESSION_TTL=168h
TESLABOX_DATA_LABEL=TESLABOX
# 初始化后优先配置文件系统 UUID，避免依赖可能变化的 /dev/sdX 名称。
# TESLABOX_DATA_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TESLABOX_DATA_MOUNT_PATH=/var/lib/teslabox
TESLABOX_IMAGE_PATH=images/teslacam.img
TESLABOX_SNAPSHOT_PATH=snapshots
TESLABOX_SNAPSHOT_MOUNT_PATH=/run/teslabox/snapshots
TESLABOX_INDEX_PATH=index
TESLABOX_STATE_PATH=state
# 活动数据盘身份和初始化进度保存在系统盘，不能放到可拔数据盘内。
TESLABOX_STORAGE_REGISTRY=/var/lib/teslabox-system/storage-registry.json
TESLABOX_CONFIGFS_PATH=/sys/kernel/config/usb_gadget
TESLABOX_UDC_PATH=/sys/class/udc
# TESLABOX_UDC_NAME=fcc00000.dwc3
TESLABOX_GADGET_NAME=teslabox
TESLABOX_GADGET_SERIAL=TESLABOX-071C4AAFBA8BEB80
TESLABOX_RELEASE_GADGET=radxa-otgutils
TESLABOX_SCAN_INTERVAL=30s
TESLABOX_POLL_INTERVAL=3s
TESLABOX_OPERATION_TIMEOUT=15s
TESLABOX_SNAPSHOT_TIMEOUT=2m
# 连续失败时指数退避的最大间隔，手动 POST /api/v1/scan 不受自动退避限制。
TESLABOX_SNAPSHOT_RETRY_MAX=10m
# 低于任一门槛时停止创建新快照，但保持 Gadget 和最后一个可用媒体快照。
TESLABOX_MIN_FREE_BYTES=8589934592
TESLABOX_MIN_FREE_PERCENT=5
TESLABOX_SHUTDOWN_TIMEOUT=10s
