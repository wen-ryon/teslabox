[Unit]
Description=TeslaBox edge service
After=local-fs.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/teslabox/teslabox.env
RuntimeDirectory=teslabox/snapshots
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/teslabox
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
