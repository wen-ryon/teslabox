[Unit]
Description=TeslaBox edge service
After=local-fs.target
Conflicts=radxa-adbd.service radxa-usbnet.service
Before=radxa-adbd.service radxa-usbnet.service

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/teslabox/teslabox.env
RuntimeDirectory=teslabox/snapshots
RuntimeDirectoryMode=0750
ExecStartPre=/usr/local/libexec/teslabox-update-helper --recover
ExecStart=/usr/local/bin/teslabox
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
