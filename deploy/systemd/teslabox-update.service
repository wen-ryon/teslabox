[Unit]
Description=TeslaBox signed update installer
After=local-fs.target

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/teslabox/teslabox.env
ExecStart=/usr/local/libexec/teslabox-update-helper
TimeoutStartSec=240
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
